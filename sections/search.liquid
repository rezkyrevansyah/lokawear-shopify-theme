<script src="{{ 'facets.js' | asset_url }}" defer></script>

<div class="collection-hero">
  <h1>{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <label for="SearchPage-input" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
    <input
      id="SearchPage-input"
      class="input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
    >
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="button">{{ 'search.submit' | t }}</button>
  </form>
</div>

{%- if search.performed -%}
  <facet-filters class="results" data-section="{{ section.id }}">
    {%- paginate search.results by 12 -%}
      {%- liquid
        assign encoded_terms = search.terms | url_encode
        assign clear_url = routes.search_url | append: '?type=product&options%5Bprefix%5D=last&q=' | append: encoded_terms
      -%}
      {% render 'facets',
        section_id: section.id,
        filters: search.filters,
        sort_options: search.sort_options,
        sort_by: search.sort_by,
        results_count: search.results_count,
        clear_url: clear_url,
        terms: search.terms
      %}

      <div class="results__grid" data-facets-part="results">
        {%- if search.results_count > 0 -%}
          {% render 'product-grid', products: search.results, paginate: paginate %}
        {%- else -%}
          <div class="results__empty">
            <p class="h3">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'cart.continue_shopping' | t }}</a>
          </div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </facet-filters>
{%- endif -%}

{% stylesheet %}
  .search-page__form {
    display: flex;
    gap: 0.5rem;
    max-width: 36rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}

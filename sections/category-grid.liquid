<div class="categories section-padding" data-reveal>
  {%- if section.settings.heading != blank -%}
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="label section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
  {%- endif -%}

  <ul class="categories__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign image = block.settings.image | default: collection.featured_image
        assign title = block.settings.title | default: collection.title
        assign url = collection.url | default: routes.all_products_collection_url
      -%}
      <li class="categories__item" {{ block.shopify_attributes }}>
        <a href="{{ url }}" class="category-card">
          <div class="category-card__media">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 900
                | image_tag:
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 990px) 25vw, 70vw',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-card__placeholder' }}
            {%- endif -%}
          </div>
          <span class="category-card__title">
            {{ title }}
            {% render 'icon', name: 'arrow' %}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .categories__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 70%;
    gap: 1rem;
    margin-inline: calc(var(--page-margin) * -1);
    padding: 0 var(--page-margin) 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin);
    list-style: none;
    scrollbar-width: none;
  }
  .categories__list::-webkit-scrollbar {
    display: none;
  }
  .categories__item {
    scroll-snap-align: start;
  }
  .category-card {
    display: grid;
    gap: 1rem;
    text-decoration: none;
  }
  .category-card:hover {
    color: inherit;
  }
  .category-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius);
  }
  .category-card__media img,
  .category-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms ease;
  }
  .category-card__placeholder {
    fill: var(--color-muted);
    opacity: 0.3;
  }
  .category-card:hover img {
    transform: scale(1.04);
  }
  .category-card__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }
  .category-card__title .icon {
    width: 1.125rem;
    transition: transform 200ms ease;
  }
  .category-card:hover .category-card__title .icon {
    transform: translateX(4px);
  }
  @media (min-width: 750px) {
    .categories__list {
      grid-auto-columns: 40%;
    }
  }
  @media (min-width: 990px) {
    .categories__list {
      grid-auto-columns: 1fr;
      gap: 1.5rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.category_grid.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Made for the everyday"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.category_grid.block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:sections.category_grid.image_info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "info": "t:sections.category_grid.title_info"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.category_grid.name",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}

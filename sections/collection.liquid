<script src="{{ 'facets.js' | asset_url }}" defer></script>

<div class="collection-hero">
  <p class="label text-muted">{{ 'collections.eyebrow' | t }}</p>
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <div class="collection-hero__text">{{ collection.description }}</div>
  {%- endif -%}
</div>

<facet-filters class="results" data-section="{{ section.id }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign clear_url = collection.url
      if collection.sort_by != blank
        assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
      endif
    -%}
    {% render 'facets',
      section_id: section.id,
      filters: collection.filters,
      sort_options: collection.sort_options,
      sort_by: collection.sort_by,
      results_count: collection.products_count,
      clear_url: clear_url
    %}

    <div class="results__grid" data-facets-part="results">
      {%- if collection.products_count > 0 -%}
        {% render 'product-grid', products: collection.products, paginate: paginate %}
      {%- else -%}
        <div class="results__empty">
          <p class="h3">{{ 'collections.empty' | t }}</p>
          <a href="{{ collection.url }}" class="button button--secondary" data-facet-link>{{ 'collections.clear_all' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</facet-filters>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "t:sections.collection.products_per_page",
      "default": 12
    }
  ]
}
{% endschema %}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign layout = section.settings.layout
  if layout == 'slider'
    assign sizes = '(min-width: 990px) 24vw, (min-width: 750px) 40vw, 70vw'
  else
    assign sizes = '(min-width: 990px) 24vw, 50vw'
  endif
-%}

<div class="featured section-padding" data-reveal data-slider>
  <div class="section-heading">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="label section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading | default: collection.title }}</h2>
    </div>

    <div class="featured__actions">
      {%- if layout == 'slider' -%}
        <div class="featured__arrows">
          <button type="button" class="icon-button featured__arrow" data-slide="-1" aria-label="{{ 'accessibility.previous' | t }}">
            {% render 'icon', name: 'arrow' %}
          </button>
          <button type="button" class="icon-button" data-slide="1" aria-label="{{ 'accessibility.next' | t }}">
            {% render 'icon', name: 'arrow' %}
          </button>
        </div>
      {%- endif -%}
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="link-arrow label">
          {{ 'products.view_all' | t }}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
  </div>

  <ul class="featured__list featured__list--{{ layout }}" role="list" data-slider-track>
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <li>{% render 'product-card', product: product, sizes: sizes %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li class="featured__placeholder">
          <div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'card__image card__placeholder' }}</div>
          <p class="card__title">{{ 'products.placeholder_title' | t }}</p>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .featured__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .featured__arrows {
    display: flex;
    gap: 0.25rem;
  }
  .featured__arrow .icon {
    transform: rotate(180deg);
  }
  .featured__list {
    padding: 0;
    list-style: none;
  }
  .featured__list--grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }
  .featured__list--slider {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 70%;
    gap: 1rem;
    margin-inline: calc(var(--page-margin) * -1);
    padding-inline: var(--page-margin);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin);
    scrollbar-width: none;
  }
  .featured__list--slider::-webkit-scrollbar {
    display: none;
  }
  .featured__list--slider > li {
    scroll-snap-align: start;
  }
  .featured__placeholder {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 750px) {
    .featured__list--slider {
      grid-auto-columns: 40%;
    }
  }
  @media (min-width: 990px) {
    .featured__list--grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 3rem 1.5rem;
    }
    .featured__list--slider {
      grid-auto-columns: calc((100% - var(--page-margin) * 2 - 4.5rem) / 4);
      gap: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Fresh off the loom"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.featured_collection.products_to_show",
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.layout",
      "options": [
        { "value": "grid", "label": "t:sections.featured_collection.layout_grid" },
        { "value": "slider", "label": "t:sections.featured_collection.layout_slider" }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.show_view_all",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}

<article class="article">
  <header class="article__header">
    <a href="{{ blog.url }}" class="label text-muted article__blog">{{ blog.title }}</a>
    <h1 class="article__title">{{ article.title }}</h1>
    <p class="text-muted">
      {{ article.published_at | time_tag: format: 'month_day_year' }}
      {%- if section.settings.show_author %} · {{ article.author }}{% endif -%}
    </p>
  </header>

  {%- if article.image -%}
    <div class="article__image">
      {{
        article.image
        | image_url: width: 2400
        | image_tag:
          widths: '720, 1080, 1600, 2400',
          sizes: 'min(100vw, 82.5rem)',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}

  <div class="rte article__content">{{ article.content }}</div>

  <footer class="article__footer">
    <div class="lurik article__lurik" aria-hidden="true"></div>
    {%- if article.tags.size > 0 -%}
      <ul class="article__tags" role="list">
        {%- for tag in article.tags -%}
          <li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="pill">{{ tag }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <a href="{{ blog.url }}" class="link-arrow label">
      {{ 'blog.back' | t: title: blog.title }}
      {% render 'icon', name: 'arrow' %}
    </a>
  </footer>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .article {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) 6rem;
  }
  .article__header,
  .article__content,
  .article__footer {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
  }
  .article__header {
    display: grid;
    gap: 1.25rem;
    text-align: center;
  }
  .article__blog {
    text-decoration: none;
  }
  .article__title {
    font-size: clamp(2.25rem, 1.6rem + 2.8vw, 4rem);
  }
  .article__image {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .article__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article__content {
    font-size: 1.125rem;
  }
  .article__footer {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .article__lurik {
    width: 3rem;
  }
  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "t:sections.article.show_author", "default": false }
  ]
}
{% endschema %}

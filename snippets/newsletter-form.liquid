{% doc %}
  Newsletter signup using Shopify's customer form. Subscribers land in Customers with the "newsletter" tag.

  @param {string} id - Unique form id, used as the scroll anchor after submit

  @example
  {% render 'newsletter-form', id: 'NewsletterFooter' %}
{% enddoc %}

{%- form 'customer', id: id, class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">

  <div class="newsletter-form__row">
    <label for="{{ id }}-email" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
    <input
      id="{{ id }}-email"
      type="email"
      name="contact[email]"
      class="input"
      placeholder="{{ 'newsletter.email' | t }}"
      autocomplete="email"
      required
      {% if form.errors %}
        aria-invalid="true" aria-describedby="{{ id }}-message"
      {% endif %}
    >
    <button type="submit" class="button">{{ 'newsletter.subscribe' | t }}</button>
  </div>

  {%- if form.posted_successfully? -%}
    <p id="{{ id }}-message" class="newsletter-form__message" role="status">{{ 'newsletter.success' | t }}</p>
  {%- elsif form.errors -%}
    <p id="{{ id }}-message" class="newsletter-form__message newsletter-form__message--error" role="alert">
      {{ form.errors.translated_fields.email | capitalize }}
      {{ form.errors.messages.email }}
    </p>
  {%- endif -%}
{%- endform -%}

{% stylesheet %}
  .newsletter-form__row {
    display: flex;
    gap: 0.5rem;
  }
  .newsletter-form__row .input {
    flex: 1;
    min-width: 0;
  }
  .newsletter-form__message {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  .newsletter-form__message--error {
    color: var(--color-accent);
  }
{% endstylesheet %}

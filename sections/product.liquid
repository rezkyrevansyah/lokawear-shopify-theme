{%- comment -%}
  Main product section. Blocks in the info column are reorderable in the theme editor.
  Variant changes re-render the [data-dynamic] parts through the Section Rendering API
  (assets/product.js), so availability and prices always come from Liquid.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign size_chart = product.metafields.custom.size_chart.value
  assign media_count = product.media.size
-%}

<script src="{{ 'product.js' | asset_url }}" defer></script>

<product-info class="product" data-section="{{ section.id }}" data-url="{{ product.url }}">
  <div class="product__media gallery">
    <ul class="gallery__track" role="list" data-gallery-track aria-label="{{ 'products.gallery' | t }}">
      {%- for media in product.media -%}
        <li class="gallery__slide" data-media-id="{{ media.id }}">
          <button
            type="button"
            class="gallery__zoom"
            data-zoom="{{ forloop.index0 }}"
            aria-label="{{ 'products.zoom' | t: index: forloop.index, count: media_count }}"
          >
            {%- liquid
              assign preload = false
              if forloop.first
                assign loading = 'eager'
                assign priority = 'high'
                assign preload = true
              else
                assign loading = 'lazy'
                assign priority = 'auto'
              endif
            -%}
            {{
              media.preview_image
              | image_url: width: 1800
              | image_tag:
                preload: preload,
                widths: '540, 720, 900, 1080, 1440, 1800',
                sizes: '(min-width: 990px) 52vw, 100vw',
                loading: loading,
                fetchpriority: priority
            }}
          </button>
        </li>
      {%- else -%}
        <li class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'gallery__placeholder' }}</li>
      {%- endfor -%}
    </ul>

    {%- if media_count > 1 -%}
      <ul class="gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <li>
            <button
              type="button"
              class="gallery__thumb"
              data-thumb="{{ forloop.index0 }}"
              aria-label="{{ 'products.show_image' | t: index: forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'title' -%}
          <div class="product__title" {{ block.shopify_attributes }}>
            {%- if product.type != blank -%}
              <p class="label text-muted">{{ product.type }}</p>
            {%- endif -%}
            <h1 class="h2">{{ product.title }}</h1>
          </div>

        {%- when 'price' -%}
          <div class="product__price" data-dynamic="price" {{ block.shopify_attributes }}>
            {% render 'price', product: product, variant: current_variant %}
          </div>

        {%- when 'variant_picker' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="product__picker" data-dynamic="picker" {{ block.shopify_attributes }}>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_handle = option.name | handleize
                  assign is_color = false
                  if option_handle == 'color' or option_handle == 'colour'
                    assign is_color = true
                  endif
                -%}
                <fieldset class="picker">
                  <legend class="picker__legend label">
                    {{ option.name }}: <span class="picker__selected">{{ option.selected_value }}</span>
                  </legend>
                  <div class="picker__values">
                    {%- for value in option.values -%}
                      {%- assign input_id = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                      <input
                        type="radio"
                        class="picker__input visually-hidden"
                        id="{{ input_id }}"
                        name="{{ option.name | escape }}-{{ section.id }}"
                        value="{{ value | escape }}"
                        data-variant-id="{{ value.variant.id }}"
                        {% if value.selected %}
                          checked
                        {% endif %}
                      >
                      <label for="{{ input_id }}" class="picker__value{% unless value.available %} is-unavailable{% endunless %}">
                        {%- if is_color -%}
                          {%- liquid
                            assign hex = value.swatch.color
                            if hex == blank
                              case value.name
                                when 'Indigo'
                                  assign hex = '#2E3A5C'
                                when 'Washed Indigo'
                                  assign hex = '#5B6E8F'
                                when 'Indigo Stripe'
                                  assign hex = '#3A4A6E'
                                when 'Navy'
                                  assign hex = '#1F2A44'
                                when 'Natural'
                                  assign hex = '#E8DFCC'
                                when 'Cream'
                                  assign hex = '#F1E8D6'
                                when 'White Stripe'
                                  assign hex = '#F7F4EE'
                                when 'Sand'
                                  assign hex = '#D8C3A0'
                                when 'Tan'
                                  assign hex = '#B88B5A'
                                when 'Taupe'
                                  assign hex = '#8E7F6E'
                                when 'Sogan Brown'
                                  assign hex = '#7A4A24'
                                when 'Olive'
                                  assign hex = '#6B6B3A'
                                when 'Sage'
                                  assign hex = '#9CA88A'
                                when 'Mint'
                                  assign hex = '#B9D3C2'
                                when 'Peach'
                                  assign hex = '#E8B796'
                                when 'Grey'
                                  assign hex = '#8C8A86'
                                when 'Charcoal'
                                  assign hex = '#3B3836'
                                when 'Black'
                                  assign hex = '#1F1B17'
                                else
                                  assign hex = 'var(--color-line)'
                              endcase
                            endif
                          -%}
                          <span class="swatch" style="--swatch: {{ hex }}"></span>
                        {%- endif -%}
                        {{ value }}
                        {%- unless value.available -%}
                          <span class="visually-hidden">, {{ 'products.sold_out' | t }}</span>
                        {%- endunless -%}
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>

                {%- if option_handle == 'size' and size_chart != blank -%}
                  <button type="button" class="picker__guide label" data-dialog-open="SizeChart-{{ section.id }}">
                    {{ 'products.size_guide' | t }}
                    {% render 'icon', name: 'arrow' %}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endunless -%}

        {%- when 'buy_buttons' -%}
          <div class="product__buy" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '' -%}
              <div data-dynamic="buy" data-media-id="{{ current_variant.featured_media.id }}">
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <button
                  type="submit"
                  class="button product-form__submit"
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >
                  {%- if current_variant.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>
              </div>
              <p class="product-form__error" role="alert" data-form-error></p>
              {%- if block.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            {%- endform -%}
          </div>

        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- endif -%}

        {%- when 'fabric_story' -%}
          {%- liquid
            assign origin = product.metafields.custom.fabric_origin.value
            assign technique = product.metafields.custom.technique.value
            assign artisan = product.metafields.custom.artisan.value
          -%}
          {%- if origin != blank or technique != blank or artisan != blank -%}
            <div class="fabric" {{ block.shopify_attributes }}>
              <div class="lurik fabric__lurik" aria-hidden="true"></div>
              <p class="label">{{ block.settings.heading }}</p>
              <dl class="fabric__facts">
                {%- if origin != blank -%}
                  <div>
                    <dt class="label text-muted">{{ 'products.origin' | t }}</dt>
                    <dd>{{ origin }}</dd>
                  </div>
                {%- endif -%}
                {%- if technique != blank -%}
                  <div>
                    <dt class="label text-muted">{{ 'products.technique' | t }}</dt>
                    <dd>{{ technique }}</dd>
                  </div>
                {%- endif -%}
              </dl>
              {%- if artisan != blank -%}
                <div class="fabric__artisan">
                  {%- assign artisan_photo = artisan.photo.value -%}
                  {%- if artisan_photo != blank -%}
                    {{ artisan_photo | image_url: width: 160 | image_tag: class: 'fabric__photo', loading: 'lazy', alt: '' }}
                  {%- endif -%}
                  <div>
                    <p class="fabric__name">{{ 'products.made_by' | t: name: artisan.name.value }}</p>
                    <p class="text-muted">{{ artisan.craft.value }}, {{ artisan.region.value }}</p>
                  </div>
                  {%- if artisan.bio.value != blank -%}
                    <p class="fabric__bio">{{ artisan.bio.value }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'care' -%}
          {%- assign care = product.metafields.custom.care_instructions.value -%}
          {%- if care != blank -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="label">
                {{ block.settings.heading }}
                {% render 'icon', name: 'chevron' %}
              </summary>
              <div class="accordion__content">{{ care | newline_to_br }}</div>
            </details>
          {%- endif -%}

        {%- when 'collapsible' -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary class="label">
              {{ block.settings.heading }}
              {% render 'icon', name: 'chevron' %}
            </summary>
            <div class="accordion__content">{{ block.settings.content }}</div>
          </details>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.sticky_add_to_cart -%}
    <div class="sticky-atc" data-sticky-atc inert>
      <div class="sticky-atc__info">
        <p class="sticky-atc__title">{{ product.title }}</p>
        <div data-dynamic="sticky-price">{% render 'price', product: product, variant: current_variant %}</div>
      </div>
      <div data-dynamic="sticky-button">
        <button
          type="submit"
          form="{{ form_id }}"
          class="button"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if size_chart != blank -%}
    <dialog id="SizeChart-{{ section.id }}" class="drawer drawer--right" scroll-lock aria-labelledby="SizeChart-{{ section.id }}-title">
      <div class="drawer__inner">
        <div class="drawer__header">
          <h2 id="SizeChart-{{ section.id }}-title" class="label">{{ size_chart.name.value }}</h2>
          <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon', name: 'close' %}
          </button>
        </div>
        <div class="drawer__body">
          {%- comment -%} The metaobject stores the table as "Size | Chest | Length" lines. {%- endcomment -%}
          {%- assign rows = size_chart.table.value | newline_to_br | split: '<br />' -%}
          {%- assign head_cells = rows.first | split: '|' -%}
          <table class="size-table">
            <thead>
              <tr>
                {%- for cell in head_cells %}<th scope="col">{{ cell | strip }}</th>{% endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in rows offset: 1 -%}
                {%- if row != blank -%}
                  {%- assign cells = row | split: '|' -%}
                  <tr>
                    {%- for cell in cells -%}
                      {%- if forloop.first -%}
                        <th scope="row">{{ cell | strip }}</th>
                      {%- else -%}
                        <td>{{ cell | strip }}</td>
                      {%- endif -%}
                    {%- endfor -%}
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
          <p class="size-table__note text-muted">{{ 'products.size_note' | t }}</p>
        </div>
      </div>
    </dialog>
  {%- endif -%}

  {%- if media_count > 0 -%}
    <dialog class="zoom" data-zoom-dialog scroll-lock aria-label="{{ 'products.gallery' | t }}">
      <button type="button" class="icon-button zoom__close" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
      <ul class="zoom__list" role="list">
        {%- for media in product.media -%}
          <li data-zoom-item>
            {{
              media.preview_image
              | image_url: width: 2400
              | image_tag: widths: '1080, 1600, 2400', sizes: 'min(100vw, 75rem)', loading: 'lazy'
            }}
          </li>
        {%- endfor -%}
      </ul>
    </dialog>
  {%- endif -%}
</product-info>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% stylesheet %}
  product-info {
    display: block;
  }
  .product {
    display: grid;
    gap: 2rem;
    padding-block: 0 4rem;
  }

  /* Gallery: native scroll-snap track, full-bleed on mobile */
  .gallery {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    margin-inline: calc(var(--page-margin) * -1);
  }
  .gallery__track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }
  .gallery__track::-webkit-scrollbar {
    display: none;
  }
  .gallery__slide {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
    scroll-snap-align: start;
  }
  .gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery__zoom img,
  .gallery__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__placeholder {
    fill: var(--color-muted);
    opacity: 0.3;
  }
  .gallery__thumbs {
    display: flex;
    gap: 0.5rem;
    padding: 0 var(--page-margin);
    list-style: none;
  }
  .gallery__thumb {
    display: block;
    width: 3.5rem;
    aspect-ratio: 4 / 5;
    padding: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--color-surface);
    opacity: 0.55;
    cursor: pointer;
    transition: opacity 200ms ease, border-color 200ms ease;
  }
  .gallery__thumb:hover,
  .gallery__thumb[aria-current='true'] {
    opacity: 1;
  }
  .gallery__thumb[aria-current='true'] {
    border-color: var(--color-text);
  }
  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Info column */
  .product__info {
    display: grid;
    align-content: start;
    gap: 1.75rem;
  }
  .product__title {
    display: grid;
    gap: 0.75rem;
  }
  .product__price {
    font-size: 1.25rem;
  }
  .product__picker {
    display: grid;
    gap: 1.5rem;
  }
  .picker {
    min-width: 0;
    padding: 0;
    border: 0;
  }
  .picker__legend {
    margin-bottom: 0.75rem;
    padding: 0;
  }
  .picker__selected {
    font-weight: var(--font-body--weight);
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .picker__values {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .picker__value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 3.25rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    cursor: pointer;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .picker__value:hover {
    border-color: var(--color-text);
  }
  .picker__input:checked + .picker__value {
    border-color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-text);
  }
  .picker__input:focus-visible + .picker__value {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .picker__value.is-unavailable {
    color: var(--color-muted);
    text-decoration: line-through;
  }
  .picker__guide {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-height: 2.75rem;
    margin-top: -0.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }
  .picker__guide .icon {
    width: 1rem;
  }

  /* Buy buttons */
  .product-form {
    display: grid;
    gap: 0.75rem;
  }
  .product-form__submit {
    width: 100%;
    min-height: 3.5rem;
  }
  .button[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }
  .product-form__error {
    color: var(--color-accent);
    font-size: 0.875rem;
  }
  .shopify-payment-button__button--unbranded {
    min-height: 3.5rem;
    border: 1px solid var(--color-text);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: var(--font-body--weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .shopify-payment-button__button--unbranded:hover:not([disabled]) {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .shopify-payment-button__more-options {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .product__description {
    color: var(--color-muted);
    font-size: 1.0625rem;
  }

  /* Fabric story: origin, technique and the artisan behind the cloth */
  .fabric {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .fabric__lurik {
    width: 3rem;
  }
  .fabric__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .fabric__facts dd {
    margin: 0.375rem 0 0;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    line-height: 1.3;
  }
  .fabric__artisan {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.25rem 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .fabric__artisan > div {
    grid-column: 1 / -1;
  }
  .fabric__photo + div {
    grid-column: 2;
  }
  .fabric__photo {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .fabric__name {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
  }
  .fabric__bio {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
  }

  /* Stacked accordions in the info column cancel the grid gap so their borders touch */
  .product__info .accordion + .accordion {
    margin-top: -1.75rem;
  }

  /* Size chart */
  .size-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .size-table th,
  .size-table td {
    padding: 0.75rem 0.5rem 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
  }
  .size-table thead th {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .size-table__note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }

  /* Full-screen zoom */
  .zoom {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    border: 0;
  }
  .zoom__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    border-radius: 50%;
    background: var(--color-bg);
  }
  .zoom__list {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .zoom__list img {
    width: 100%;
    max-width: 75rem;
    margin-inline: auto;
  }

  /* Sticky add to cart, mobile only, shown once the main button scrolls away */
  .sticky-atc {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--page-margin) calc(0.75rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    transform: translateY(100%);
    transition: transform 300ms ease;
  }
  .sticky-atc.is-visible {
    transform: none;
  }
  .sticky-atc__info {
    flex: 1;
    min-width: 0;
    font-size: 0.875rem;
  }
  .sticky-atc__title {
    overflow: hidden;
    font-family: var(--font-heading--family);
    font-size: 1rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sticky-atc .button {
    padding-inline: 1.25rem;
  }

  @media (min-width: 990px) {
    .product {
      grid-template-columns: 7fr 5fr;
      align-items: start;
      gap: clamp(3rem, 6vw, 6rem);
      padding-block: 2.5rem 6rem;
    }
    .gallery {
      grid-template-columns: 4.5rem 1fr;
      align-items: start;
      gap: 1rem;
      margin-inline: 0;
    }
    .gallery__track {
      border-radius: var(--radius);
    }
    .gallery__thumbs {
      flex-direction: column;
      order: -1;
      padding: 0;
    }
    .gallery__thumb {
      width: 100%;
    }
    .product__info {
      position: sticky;
      top: 6rem;
    }
    .sticky-atc {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_add_to_cart",
      "label": "t:sections.product.sticky_add_to_cart",
      "info": "t:sections.product.sticky_add_to_cart_info",
      "default": true
    }
  ],
  "blocks": [

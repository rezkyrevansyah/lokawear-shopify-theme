<article class="page-content section-padding">
  <header class="page-content__header">
    <div class="lurik page-content__lurik" aria-hidden="true"></div>
    <h1 class="h2">{{ page.title }}</h1>
  </header>
  <div class="rte">{{ page.content }}</div>
</article>

{% stylesheet %}
  .page-content {
    display: grid;
    gap: 2.5rem;
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }
  .page-content__header {
    display: grid;
    gap: 1.5rem;
  }
  .page-content__lurik {
    width: 3rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}

{%- comment -%}
  One look per section: an editorial photo with numbered product pins and a matching
  "shop the look" list. Pins are plain links, positioned as percentages of the image.
{%- endcomment -%}

{%- assign image = section.settings.image -%}

<div class="look{% if section.settings.image_position == 'right' %} look--flip{% endif %} section-padding" data-reveal>
  <div class="look__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 1800
        | image_tag:
          widths: '540, 720, 1080, 1440, 1800',
          sizes: '(min-width: 990px) 58vw, 100vw',
          loading: 'lazy',
          class: 'look__image'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'look__image look__placeholder' }}
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.settings.product != blank -%}
        <a
          href="{{ block.settings.product.url }}"
          class="look__pin"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%"
          {{ block.shopify_attributes }}
        >
          <span aria-hidden="true">{{ forloop.index }}</span>
          <span class="look__tip">{{ block.settings.product.title }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="look__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="label text-muted">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="text-muted">{{ section.settings.text }}</div>
    {%- endif -%}

    <p class="label look__shop">{{ 'sections.lookbook.shop_the_look' | t }}</p>
    <ol class="look__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          <li>
            <a href="{{ product.url }}" class="look__item">
              <span class="look__number" aria-hidden="true">{{ forloop.index }}</span>
              <span class="look__thumb">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
              </span>
              <span>
                <span class="look__title">{{ product.title }}</span>
                {% render 'price', product: product %}
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</div>

{% stylesheet %}
  .look {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .look__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .look__image {
    width: 100%;
  }
  .look__placeholder {
    aspect-ratio: 4 / 5;
    fill: var(--color-muted);
    opacity: 0.3;
  }
  .look__pin {
    position: absolute;
    top: var(--y);
    left: var(--x);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: var(--font-body--weight-bold);
    text-decoration: none;
    box-shadow: 0 0 0 6px rgb(246 241 233 / 0.35);
    transform: translate(-50%, -50%);
    transition: box-shadow 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .look__pin:hover,
  .look__pin:focus-visible {
    background: var(--color-primary);
    color: var(--color-bg);
    box-shadow: 0 0 0 10px rgb(246 241 233 / 0.45);
  }
  .look__tip {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    left: 50%;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: var(--font-body--weight);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .look__pin:hover .look__tip,
  .look__pin:focus-visible .look__tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .look__content {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    max-width: 28rem;
  }
  .look__shop {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .look__list {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .look__item {
    display: grid;
    grid-template-columns: 1.5rem 3.5rem 1fr;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  .look__number {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    color: var(--color-muted);
  }
  .look__thumb {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .look__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .look__title {
    display: block;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
  }
  .look__item .price {
    font-size: 0.875rem;
  }
  @media (min-width: 990px) {
    .look {
      grid-template-columns: 7fr 5fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
    .look--flip {
      grid-template-columns: 5fr 7fr;
    }
    .look--flip .look__media {
      order: 2;
    }
    .look--flip .look__content {
      justify-self: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.lookbook.image_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Look 01" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Slow morning" },
    { "type": "richtext", "id": "text", "label": "t:labels.text" }
  ],
  "blocks": [
    {
      "type": "pin",
      "name": "t:sections.lookbook.pin",
      "settings": [
        { "type": "product", "id": "product", "label": "t:general.product" },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "t:sections.lookbook.x", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "t:sections.lookbook.y", "default": 50 }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "t:sections.lookbook.name",
      "blocks": [{ "type": "pin" }, { "type": "pin" }]
    }
  ]
}
{% endschema %}

{%- liquid
  assign heading = settings.type_heading_font
  assign body = settings.type_body_font
  assign body_bold = body | font_modify: 'weight', '600'
-%}

{% style %}
  {{ heading | font_face: font_display: 'swap' }}
  {{ heading | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ body | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}

  :root {
    --font-heading--family: {{ heading.family }}, {{ heading.fallback_families }};
    --font-heading--weight: {{ heading.weight }};
    --font-body--family: {{ body.family }}, {{ body.fallback_families }};
    --font-body--weight: {{ body.weight }};
    --font-body--weight-bold: {{ body_bold.weight | default: 700 }};

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --radius: {{ settings.corner_radius }}px;

    --color-bg: {{ settings.color_bg }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-muted: {{ settings.color_muted }};
    --color-primary: {{ settings.color_primary }};
    --color-accent: {{ settings.color_accent }};
    --color-line: {{ settings.color_line }};
  }
{% endstyle %}

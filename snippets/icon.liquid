{% doc %}
  Inline line icon, 1.5px stroke, inherits currentColor.

  @param {string} name - account | cart | search | menu | close | filter | chevron | arrow | instagram | tiktok | facebook | pinterest
  @param {string} [class] - Extra class on the svg

  @example
  {% render 'icon', name: 'cart' %}
{% enddoc %}

<svg
  class="icon icon--{{ name }} {{ class }}"
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {%- case name -%}
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
    {%- when 'menu' -%}
      <path d="M3 7h18M3 12h18M3 17h18"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'filter' -%}
      <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>
    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'arrow' -%}
      <path d="M4 12h16m-6-6 6 6-6 6"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 3 2.5 5 6 5"/>
    {%- when 'facebook' -%}
      <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2V3Z"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9"/><path d="M11 8.5c3-1 5.5.5 5 3.5-.4 2.4-2.6 3.4-4 2.5M12 10l-2.5 11"/>
  {%- endcase -%}
</svg>

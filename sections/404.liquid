<div class="not-found section-padding">
  <div class="lurik not-found__lurik" aria-hidden="true"></div>
  <p class="label text-muted">{{ '404.title' | t }}</p>
  <h1>{{ '404.heading' | t }}</h1>
  <p class="text-muted not-found__text">{{ '404.not_found' | t }}</p>

  <form action="{{ routes.search_url }}" method="get" role="search" class="not-found__search">
    <label for="NotFound-search" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
    <input id="NotFound-search" class="input" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="button">{{ 'search.submit' | t }}</button>
  </form>

  <a href="{{ routes.all_products_collection_url }}" class="link-arrow label">
    {{ '404.back_to_shopping' | t }}
    {% render 'icon', name: 'arrow' %}
  </a>
</div>

{% stylesheet %}
  .not-found {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    max-width: 40rem;
    margin-inline: auto;
    padding-block: clamp(5rem, 12vw, 9rem);
    text-align: center;
  }
  .not-found__lurik {
    width: 3.5rem;
  }
  .not-found__text {
    font-size: 1.125rem;
  }
  .not-found__search {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    margin-block: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}

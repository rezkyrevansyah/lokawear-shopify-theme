{%- comment -%}
  Rendered only through /search/suggest?section_id=predictive-search by the search drawer
  in the header (assets/theme.js). Not meant to be added to a template.
{%- endcomment -%}

<div data-predictive-results>
  {%- if predictive_search.performed -%}
    {%- liquid
      assign resources = predictive_search.resources
      assign encoded_terms = predictive_search.terms | url_encode
      assign total = resources.products.size | plus: resources.collections.size | plus: resources.queries.size
    -%}

    {%- if resources.queries.size > 0 -%}
      <ul class="suggest__queries" role="list">
        {%- for query in resources.queries -%}
          <li><a href="{{ query.url }}" class="pill">{{ query.styled_text }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if resources.collections.size > 0 -%}
      <p class="label text-muted suggest__heading">{{ 'search.collections' | t }}</p>
      <ul class="suggest__links" role="list">
        {%- for collection in resources.collections -%}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if resources.products.size > 0 -%}
      <p class="label text-muted suggest__heading">{{ 'search.products' | t }}</p>
      <ul class="suggest__products" role="list">
        {%- for product in resources.products -%}
          <li>
            <a href="{{ product.url }}" class="suggest__product">
              <div class="suggest__image">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
              </div>
              <div>
                <p class="suggest__title">{{ product.title }}</p>
                {% render 'price', product: product %}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if total == 0 -%}
      <p class="suggest__empty">{{ 'search.no_results_html' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}

    <a href="{{ routes.search_url }}?q={{ encoded_terms }}&type=product&options%5Bprefix%5D=last" class="link-arrow label suggest__all">
      {{ 'search.view_all' | t: terms: predictive_search.terms }}
      {% render 'icon', name: 'arrow' %}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .suggest__queries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .suggest__queries mark {
    background: none;
    color: inherit;
    font-weight: var(--font-body--weight-bold);
  }
  .suggest__heading {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .suggest__links,
  .suggest__products {
    display: grid;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }
  .suggest__links a {
    display: block;
    padding-block: 0.375rem;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    text-decoration: none;
  }
  .suggest__products {
    gap: 1rem;
  }
  .suggest__product {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  .suggest__image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .suggest__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .suggest__title {
    font-family: var(--font-heading--family);
    font-size: 1.0625rem;
  }
  .suggest__product .price {
    font-size: 0.875rem;
  }
  .suggest__empty {
    margin-top: 1rem;
    color: var(--color-muted);
  }
  .suggest__all {
    margin-top: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.predictive_search.name",
  "settings": []
}
{% endschema %}

{%- comment -%}
  Lists every entry of the "artisan" metaobject, so new makers added in the admin
  appear here without editing the theme.
{%- endcomment -%}

<div class="makers section-padding" data-reveal>
  <div class="section-heading">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="label section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.text != blank -%}
      <div class="makers__intro text-muted">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <ul class="makers__list" role="list">
    {%- for artisan in shop.metaobjects.artisan.values limit: 6 -%}
      <li class="maker">
        {%- assign photo = artisan.photo.value -%}
        {%- if photo != blank -%}
          {{ photo | image_url: width: 240 | image_tag: class: 'maker__photo', loading: 'lazy', alt: '' }}
        {%- else -%}
          <span class="maker__monogram" aria-hidden="true">{{ artisan.name.value | split: ' ' | last | slice: 0 }}</span>
        {%- endif -%}
        <div class="lurik maker__lurik" aria-hidden="true"></div>
        <h3 class="maker__name">{{ artisan.name.value }}</h3>
        <p class="label text-muted">{{ artisan.craft.value }} · {{ artisan.region.value }}</p>
        {%- if artisan.bio.value != blank -%}
          <p class="maker__bio">{{ artisan.bio.value }}</p>
        {%- endif -%}
      </li>
    {%- else -%}
      <li class="maker">
        <p class="text-muted">{{ 'sections.makers.empty' | t }}</p>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .makers__intro {
    max-width: 28rem;
  }
  .makers__list {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .maker {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .maker__photo,
  .maker__monogram {
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .maker__monogram {
    display: grid;
    place-items: center;
    background: var(--color-primary);
    color: var(--color-bg);
    font-family: var(--font-heading--family);
    font-size: 2rem;
  }
  .maker__lurik {
    width: 2.5rem;
  }
  .maker__name {
    font-size: 1.75rem;
  }
  .maker__bio {
    margin-top: 0.5rem;
  }
  @media (min-width: 750px) {
    .makers__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.makers.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.makers.info"
    },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The makers" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Hands behind the cloth" },
    { "type": "richtext", "id": "text", "label": "t:labels.text" }
  ],
  "presets": [{ "name": "t:sections.makers.name" }]
}
{% endschema %}

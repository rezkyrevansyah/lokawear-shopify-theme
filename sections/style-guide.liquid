{% comment %}
  Temporary design-token preview. Replaced by the real homepage sections in milestone 3.
{% endcomment %}

<div class="style-guide">
  <p class="label text-muted">Lokawear design system</p>
  <h1>Rooted in craft. <em>Cut for today.</em></h1>
  <p class="style-guide__lead text-muted">
    Handwoven in Troso. Washed soft. Made to be worn every week.
  </p>

  <div class="style-guide__buttons">
    <a href="{{ routes.all_products_collection_url }}" class="button">Shop the collection</a>
    <a href="#" class="button button--secondary">Our craft</a>
  </div>

  <div class="style-guide__type">
    <h2>Heading two</h2>
    <h3>Heading three</h3>
    <h4>Heading four</h4>
    <p>
      Body text in the sans-serif, sixteen pixels on a 1.6 line height.
      <a href="#">A link looks like this</a>, and turns terracotta on hover.
    </p>
    <p class="label">Label · Outer &amp; Shirts</p>
  </div>

  <ul class="style-guide__swatches" role="list">
    {%- liquid
      assign tokens = 'bg,surface,text,muted,primary,accent,line' | split: ','
    -%}
    {%- for token in tokens -%}
      {%- assign key = 'color_' | append: token -%}
      <li>
        <span class="style-guide__chip" style="background: var(--color-{{ token }})"></span>
        <span class="label">{{ token }}</span>
        <span class="text-muted">{{ settings[key] }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .style-guide {
    padding-block: clamp(3rem, 8vw, 7rem);
    display: grid;
    gap: 2rem;
  }
  .style-guide h1 {
    max-width: 14ch;
  }
  .style-guide__lead {
    max-width: 40ch;
    font-size: 1.125rem;
  }
  .style-guide__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .style-guide__type {
    display: grid;
    gap: 1rem;
    padding-block: 2.5rem;
    border-block: 1px solid var(--color-line);
  }
  .style-guide__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .style-guide__swatches li {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
  }
  .style-guide__chip {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Style guide (temporary)",
  "settings": []
}
{% endschema %}

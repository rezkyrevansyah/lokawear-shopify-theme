[
  {
    "name": "theme_info",
    "theme_name": "Lokawear",
    "theme_version": "0.1.0",
    "theme_author": "M. Rezky Revansyah",
    "theme_documentation_url": "https://github.com/rezkyrevansyah/lokawear-shopify-theme",
    "theme_support_url": "https://github.com/rezkyrevansyah/lokawear-shopify-theme/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "fraunces_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "inter_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "82.5rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "100rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "82.5rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "t:labels.corner_radius",
        "default": 2
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.color_contrast"
      },
      {
        "type": "color",
        "id": "color_bg",
        "default": "#F6F1E9",
        "label": "t:labels.color_bg"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#EAE1D3",
        "label": "t:labels.color_surface"
      },
      {
        "type": "color",
        "id": "color_text",
        "default": "#1F1B17",
        "label": "t:labels.color_text"
      },
      {
        "type": "color",
        "id": "color_muted",
        "default": "#6C635B",
        "label": "t:labels.color_muted"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#2E3A5C",
        "label": "t:labels.color_primary"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#A14C29",
        "label": "t:labels.color_accent"
      },
      {
        "type": "color",
        "id": "color_line",
        "default": "#D6CCBC",
        "label": "t:labels.color_line"
      }
    ]

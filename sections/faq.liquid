<div class="faq section-padding">
  <div class="faq__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="label text-muted">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="faq__heading">{{ section.settings.heading }}</h2>
  </div>

  <div class="faq__list">
    {%- for block in section.blocks -%}
      {%- comment -%} A shared name makes the native accordion open one answer at a time. {%- endcomment -%}
      <details class="accordion faq__item" name="faq-{{ section.id }}" {{ block.shopify_attributes }}>
        <summary>
          <span class="faq__question">{{ block.settings.question }}</span>
          {% render 'icon', name: 'chevron' %}
        </summary>
        <div class="accordion__content faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .faq {
    display: grid;
    gap: 2rem;
  }
  .faq__intro {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .faq__item + .faq__item {
    border-top: 0;
  }
  .faq__item summary {
    gap: 1.5rem;
    padding-block: 1.25rem;
  }
  .faq__question {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .faq__answer {
    max-width: 40rem;
  }
  .faq__answer p + p {
    margin-top: 1em;
  }
  @media (min-width: 990px) {
    .faq {
      grid-template-columns: 4fr 8fr;
      gap: clamp(3rem, 8vw, 8rem);
    }
    .faq__intro {
      position: sticky;
      top: 7rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Help" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Questions, answered" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.block",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq.question", "default": "How long does shipping take?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.answer",
          "default": "<p>Orders ship within two working days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [{ "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}

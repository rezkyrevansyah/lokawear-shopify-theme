<div class="collection-hero blog-hero">
  <p class="label text-muted">{{ section.settings.eyebrow }}</p>
  <h1>{{ blog.title }}</h1>
  {%- if section.settings.text != blank -%}
    <div class="collection-hero__text">{{ section.settings.text }}</div>
  {%- endif -%}
</div>

{%- paginate blog.articles by 9 -%}
  <ul class="articles" role="list">
    {%- for article in blog.articles -%}
      <li class="articles__item{% if forloop.first and paginate.current_page == 1 %} articles__item--featured{% endif %}">
        {% render 'article-card', article: article, eager: forloop.first %}
      </li>
    {%- else -%}
      <li class="text-muted">{{ 'blog.empty' | t }}</li>
    {%- endfor -%}
  </ul>

  {%- if paginate.pages > 1 -%}
    <nav class="blog-pagination" aria-label="{{ 'collections.pagination' | t }}">
      {{ paginate | default_pagination }}
    </nav>
  {%- endif -%}
{%- endpaginate -%}

{% stylesheet %}
  .articles {
    display: grid;
    gap: 3rem 1.5rem;
    padding: 0 0 6rem;
    list-style: none;
  }
  .blog-pagination {
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding-bottom: 5rem;
  }
  @media (min-width: 750px) {
    .articles {
      grid-template-columns: repeat(2, 1fr);
    }
    .articles__item--featured {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Journal" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Notes from the looms, dye vats and stamping tables where our cloth begins.</p>"
    }
  ]
}
{% endschema %}

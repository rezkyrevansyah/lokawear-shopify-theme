{%- comment -%}
  Empty on first render; assets/product.js fetches this section from the recommendations
  endpoint and swaps in the filled markup. Reuses the featured collection slider styles.
{%- endcomment -%}

{%- assign limit = section.settings.products_to_show -%}

<product-recommendations
  class="featured"
  data-slider
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="section-padding">
      <div class="section-heading">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="label section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <div class="featured__arrows">
          <button type="button" class="icon-button featured__arrow" data-slide="-1" aria-label="{{ 'accessibility.previous' | t }}">
            {% render 'icon', name: 'arrow' %}
          </button>
          <button type="button" class="icon-button" data-slide="1" aria-label="{{ 'accessibility.next' | t }}">
            {% render 'icon', name: 'arrow' %}
          </button>
        </div>
      </div>
      <ul class="featured__list featured__list--slider" role="list" data-slider-track>
        {%- for rec in recommendations.products -%}
          <li>
            {% render 'product-card', product: rec, sizes: '(min-width: 990px) 24vw, (min-width: 750px) 40vw, 70vw' %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% stylesheet %}
  product-recommendations {
    display: block;
  }
  product-recommendations > .section-padding {
    border-top: 1px solid var(--color-line);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Complete the look" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "You may also like" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "t:sections.featured_collection.products_to_show",
      "default": 6
    }
  ],
  "presets": [
    { "name": "t:sections.product_recommendations.name" }
  ]
}
{% endschema %}
